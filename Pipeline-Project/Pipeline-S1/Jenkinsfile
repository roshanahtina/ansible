pipeline {
    agent {
	    label 'ansible-agent'
    }

    // ── Environments ───────────────────────────────────────────────
    environment {
        // Ansible Vault Password - Jenkins Secret File
        VAULT_PASS_FILE = credentials('ansible-vault-password')
    }

    // ── Parameters ───────────────────────────────────────────────
    parameters {
        choice(
            name: 'Choose_Environment',
            choices: ['ansiclients', 'dbclients', 'webclients', 'ansimaster', 'localhost', 'all'],
            description: 'Target deployment environment'
        )
        string(
            name: 'Choose_Playbook',
            defaultValue: 'ping.yml',
            description: 'Ansible playbook to run'
        )
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: false,
            description: 'Check mode — no changes made'
        )
        booleanParam(
            name: 'VERBOSE',
            defaultValue: false,
            description: 'Enable verbose output (-vvv)'
        )
    }

    stages {

        stage('Checkout') {
            steps {
                git url: 'https://github.com/roshanahtina/ansible.git'
            }
        }
        
        stage('Ansible Playbook') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'ansible-vault-password',
                        variable: 'VAULT_PASS_FILE'
                    )
                ]) {
                    sh '''
                        ansible-playbook \
                            -i inv.ini \
                            -l "${Choose_Environment}" \
                            "${Choose_Playbook}" \
                            --vault-password-file $VAULT_PASS_FILE
                    '''
                }
            }
        }
    }
}
