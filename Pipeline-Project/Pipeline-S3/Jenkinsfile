pipeline {
    agent {
        label 'ansible-agent'
    }

    // ── Environments ───────────────────────────────────────────────
    environment {
        // Ansible Vault Password - Jenkins Secret Text
        VAULT_PASS_TEXT = credentials('ansible-vault-passwd')
    }

    // ── Options ──────────────────────────────────────────────────
    parameters {
        choice (
            name: 'ENVIRONMENT',
            choices: ['ansiclients', 'dbclients', 'webclients', 'ansimaster'],
            description: 'Target deployment environment'
        )
        //choice (
        //    name: 'ANSIBLE_MODULE',
        //    choices: ['script', 'shell', 'command'],
        //    description: 'Ansible module to run'
        //)
        //choice (
        //    name: 'CHECK_SHELL_SCRIPT',
        //    choices: ['mem_check.sh', 'load_check.sh', 'disk_check.sh', 'process_check.sh', 'network_check.sh'],
        //    description: 'Ansible script to execute'
        //)
        booleanParam (
        name: 'MEMORY_CHECK',
        defaultValue: false,
        description: 'Check health — MEMORY_CHECK'
        )
        booleanParam (
        name: 'LOAD_CHECK',
        defaultValue: false,
        description: 'Check health — LOAD_CHECK'
        )
        booleanParam (
        name: 'DISK_CHECK',
        defaultValue: false,
        description: 'Check health — DISK_CHECK'
        )
        booleanParam (
        name: 'NETWORK_CHECK',
        defaultValue: false,
        description: 'Check health — NETWORK_CHECK'
        )
        booleanParam (
        name: 'PROCESS_CHECK',
        defaultValue: false,
        description: 'Check health — PROCESS_CHECK'
        )
    }

    stages {
        //stage ('Server Health Checks') {
        //    steps {
        //        ansiColor('xterm')
        //        {
        //        sh '''
        //            set +x
        //            # Write a password ao temp file
        //            TEMP_PASS=$(mktemp)
        //            echo "$VAULT_PASS_TEXT" > $TEMP_PASS
        //            chmod 600 $TEMP_PASS
        //            # Selected Script
        //            # echo "Selected Check Script: Pipeline-Project/Pipeline-S3/${CHECK_SHELL_SCRIPT}"
        //            # Run Ansible CMD
        //            ansible all \
        //                -i inv.ini \
        //                -l "${ENVIRONMENT}" \
        //                -m "${ANSIBLE_MODULE}" \
        //                -a "Pipeline-Project/Pipeline-S3/${CHECK_SHELL_SCRIPT}" \
        //                -b -o \
        //                --vault-password-file $TEMP_PASS
        //            
        //            # Cleanup temp file
        //            rm -f $TEMP_PASS
        //        '''
        //        }
        //    }
        //}
        stage ('Server Health Checks - Chosen') {
            steps {
                script {
                    def ansibleBase = "ansible all -i inv.ini -l ${params.ENVIRONMENT} -m script"
                    def runScript = { scriptName -> 
                        def output = sh(
                            script: """
                        # Write a password ao temp file
                        TEMP_PASS=\$(mktemp)
                        echo "\$VAULT_PASS_TEXT" > \$TEMP_PASS
                        chmod 600 \$TEMP_PASS

                        ${ansibleBase} \
                        -a "Pipeline-Project/Pipeline-S3/${scriptName}" \
                        -b -o \
                        --vault-password-file \$TEMP_PASS

                        # Cleanup temp file
                        rm -f \$TEMP_PASS
                        """,
                            returnStdout: true
                        ).trim()

                            echo """
                        ========================================
                        Health Check: ${scriptName}
                        ========================================
                        
                        ${output}
                        
                        ========================================
                        """
                    }

                    if (params.MEMORY_CHECK) {
                        runScript('mem_check.sh')
                    }

                    if (params.LOAD_CHECK) {
                        runScript ('load_check.sh')
                    }

                    if (params.DISK_CHECK) {
                        runScript ('disk_check.sh')
                    }

                    if (params.NETWORK_CHECK) {
                        runScript ('network_check.sh')
                    }

                    if (params.PROCESS_CHECK) {
                        runScript ('process_check.sh')
                    }
                        
                    //if (params.MEMORY_CHECK) {
                    //    stage ('MEMORY_CHECK') {
                    //        sh """
                    //        set -x
                    //        chmod +x Pipeline-Project/Pipeline-S3/mem_check.sh
                    //        ${ansibleCmd} -a "Pipeline-Project/Pipeline-S3/mem_check.sh" -b -o --vault-password-file ${params.VAULT_PASS_TEXT}
                    //        """
                    //    }
                    //}
                    //if (params.LOAD_CHECK) {
                    //    stage ('LOAD_CHECK') {
                    //        sh """
                    //        set +x
                    //        chmod +x Pipeline-Project/Pipeline-S3/load_check.sh
                    //        ${ansibleCmd} -a "Pipeline-Project/Pipeline-S3/load_check.sh" -b -o --vault-password-file ${params.VAULT_PASS_TEXT}
                    //        """
                    //    }
                    //}
                    //if (params.DISK_CHECK) {
                    //    stage ('DISK_CHECK') {
                    //        sh """
                    //        set +x
                    //        chmod +x Pipeline-Project/Pipeline-S3/disk_check.sh
                    //        ${ansibleCmd} -a "Pipeline-Project/Pipeline-S3/disk_check.sh" -b -o --vault-password-file ${params.VAULT_PASS_TEXT}
                    //        """
                    //    }
                    //}
                    //if (params.NETWORK_CHECK) {
                    //    stage ('NETWORK_CHECK') {
                    //        sh """
                    //        set +x
                    //        chmod +x Pipeline-Project/Pipeline-S3/network_check.sh
                    //        ${ansibleCmd} -a "Pipeline-Project/Pipeline-S3/network_check.sh" -b -o --vault-password-file ${params.VAULT_PASS_TEXT}
                    //        """
                    //    }
                    //}
                    //if (params.PROCESS_CHECK) {
                    //    stage ('PROCESS_CHECK') {
                    //        sh """
                    //        set +x
                    //        chmod +x Pipeline-Project/Pipeline-S3/process_check.sh
                    //        ${ansibleCmd} -a "Pipeline-Project/Pipeline-S3/process_check.sh" -b -o --vault-password-file ${params.VAULT_PASS_TEXT}
                    //        """
                    //    }
                    //}
                }
            }
        }
    }
}