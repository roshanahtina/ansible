pipeline {
    agent {
        label: 'ansible-agent'
    }

    // ── Environments ───────────────────────────────────────────────
    environment {
        // Ansible Vault Password - Jenkins Secret Text
        VAULT_PASS_TEXT = credentials('ansible-vault-passwd')
    }

    // ── Options ──────────────────────────────────────────────────
    parameters {
        choise (
            name: 'ENVIRONMENT',
            choices: ['ansiclients', 'dbclients', 'webclients', 'ansimaster'],
            description: 'Target deployment environment'
        )
        choise (
            name: 'ANSIBLE_MODULE',
            defaultValue: ['mem_check.sh', 'load_check.sh', 'disk_check.sh', 'process_check.sh' 'network_check.sh'],
            description: 'Ansible module to run'
        )
        choise (
            name: 'SHELL_SCRIPT',
            defaultValue: ['mem_check.sh', 'load_check.sh', 'disk_check.sh', 'process_check.sh' 'network_check.sh'],
            description: 'Ansible module to run'
        )
    }

    stages {
        stage {
            steps {
                ansiColor('xterm')
                {
                    sh '''
                        set +x
                        # Write a password ao temp file
                        TEMP_PASS=$(mktemp)
                        echo "$VAULT_PASS_TEXT" > $TEMP_PASS
                        chmod 600 $TEMP_PASS

                        # Run Palybook
                        ansible-playbook \
                            -i inv.ini \
                            -l "${ENVIRONMENT}" \
                            -m "${ANSIBLE_MODULE}" \
                            -a "Pipeline-Project/Pipeline-S3/${SHELL_SCRIPT}"
                            --vault-password-file $TEMP_PASS
                        
                        # Cleanup temp file
                        rm -f $TEMP_PASS
                    '''
                }
            }
        }
    }
}